# ---- Local dev against the Firebase emulator suite (default) ----
NEXT_PUBLIC_USE_EMULATOR=true

# ---- Production values (get these from Firebase console > Project settings) ----
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional payment adapters (leave unset to use manual transaction IDs)
# BKASH_APP_KEY=
# NAGAD_MERCHANT_ID=
# SSLCOMMERZ_STORE_ID=
# AI_PROVIDER=
# AI_API_KEY=
